<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0F0F0F"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F4845F"/>
      <stop offset="100%" style="stop-color:#E86F48"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="100" fill="url(#bgGrad)"/>
  
  <!-- Orange accent circle -->
  <circle cx="256" cy="256" r="160" fill="#E86F48" opacity="0.12"/>
  
  <!-- Robot head -->
  <g transform="translate(256, 256)">
    <!-- Head -->
    <rect x="-80" y="-80" width="160" height="130" rx="28" fill="#2A2A2A" stroke="#E86F48" stroke-width="5"/>
    
    <!-- Eyes -->
    <circle cx="-32" cy="-18" r="16" fill="#E86F48"/>
    <circle cx="32" cy="-18" r="16" fill="#E86F48"/>
    <circle cx="-32" cy="-18" r="7" fill="#1A1A1A"/>
    <circle cx="32" cy="-18" r="7" fill="#1A1A1A"/>
    
    <!-- Mouth -->
    <rect x="-35" y="24" width="70" height="8" rx="4" fill="#E86F48"/>
    
    <!-- Antenna -->
    <line x1="0" y1="-80" x2="0" y2="-110" stroke="#E86F48" stroke-width="5" stroke-linecap="round"/>
    <circle cx="0" cy="-116" r="10" fill="#E86F48"/>
    
    <!-- Ears -->
    <rect x="-98" y="-24" width="18" height="36" rx="5" fill="#E86F48"/>
    <rect x="80" y="-24" width="18" height="36" rx="5" fill="#E86F48"/>
  </g>
</svg>
