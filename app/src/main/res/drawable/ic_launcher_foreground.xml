<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#0F0F0F"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F4845F"/>
      <stop offset="100%" style="stop-color:#E86F48"/>
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="20" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="100" fill="url(#bgGrad)"/>
  
  <!-- Orange glow circle -->
  <circle cx="256" cy="240" r="140" fill="#E86F48" opacity="0.15" filter="url(#glow)"/>
  
  <!-- Robot head -->
  <g transform="translate(256, 230)">
    <!-- Head outline -->
    <rect x="-70" y="-70" width="140" height="120" rx="24" fill="#2A2A2A" stroke="#E86F48" stroke-width="4"/>
    
    <!-- Eyes -->
    <circle cx="-28" cy="-15" r="14" fill="#E86F48"/>
    <circle cx="28" cy="-15" r="14" fill="#E86F48"/>
    <circle cx="-28" cy="-15" r="6" fill="#1A1A1A"/>
    <circle cx="28" cy="-15" r="6" fill="#1A1A1A"/>
    
    <!-- Mouth -->
    <rect x="-30" y="20" width="60" height="6" rx="3" fill="#E86F48"/>
    
    <!-- Antenna -->
    <line x1="0" y1="-70" x2="0" y2="-95" stroke="#E86F48" stroke-width="4" stroke-linecap="round"/>
    <circle cx="0" cy="-100" r="8" fill="#E86F48"/>
    
    <!-- Ears -->
    <rect x="-85" y="-20" width="15" height="30" rx="4" fill="#E86F48"/>
    <rect x="70" y="-20" width="15" height="30" rx="4" fill="#E86F48"/>
  </g>
  
  <!-- Text: OpenClaude -->
  <text x="256" y="420" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="42" font-weight="800" fill="#F5F0E6">OpenClaude</text>
  
  <!-- Subtitle -->
  <text x="256" y="455" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="18" font-weight="500" fill="#888888">AI Coding Agent</text>
</svg>
